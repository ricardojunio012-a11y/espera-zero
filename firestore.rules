
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Unidades: leitura pública, escrita somente pelo Admin SDK.
    match /unidades/{slug} {
      allow read: if true;
      allow write: if false;

      match /agenda/{dia} {
        allow read: if true;
        allow write: if false;
      }
    }

    // Check-ins: leitura pública e criação validada.
    match /checkins/{id} {
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
          'slug',
          'uid',
          'especialidade',
          'janela',
          'minutos',
          'criadoEm',
          'risco'
        ])
        && request.resource.data.keys().hasAll([
          'slug',
          'uid',
          'especialidade',
          'janela',
          'minutos',
          'criadoEm'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.slug is string
        && request.resource.data.especialidade is string
        && request.resource.data.janela is int
        && request.resource.data.minutos is int
        && request.resource.data.minutos >= 0
        && request.resource.data.minutos <= 360
        && (
          !('risco' in request.resource.data)
          || request.resource.data.risco is string
        )
        && id == request.resource.data.slug + '_'
          + request.auth.uid + '_'
          + string(request.resource.data.janela)
        && request.resource.data.janela * 1800000
          <= request.time.toMillis()
        && request.time.toMillis()
          < (request.resource.data.janela + 1) * 1800000
        && request.resource.data.criadoEm == request.time;

      allow update, delete: if false;
    }

    // Alertas: leitura pública, sem escrita pelo cliente.
    match /alertas/{id} {
      allow read: if true;
      allow create, update, delete: if false;
    }
  }
}
