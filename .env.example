# Copie para .env.local. Nada aqui é segredo: a configuração web do Firebase é pública.

# mock (padrão): espera simulada, sem rede. firestore: lê e grava no Firebase.
VITE_DATA_SOURCE=mock

# true liga o site nos emuladores (npm run emuladores). Use com o projeto demo.
VITE_USE_EMULATOR=false

# Em produção (Firebase Hosting) estes campos ficam vazios: o site lê /__/firebase/init.json.
# Para rodar localmente contra os emuladores:
#   VITE_FIREBASE_PROJECT_ID=demo-espera-zero
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
